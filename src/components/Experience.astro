---
import { siteConfig } from "../config";
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" aria-labelledby="experience-heading" class="section-shell">
      <div class="section-grid">
        <header class="space-y-3 lg:col-span-4">
          <p class="section-kicker">Career</p>
          <h2 id="experience-heading" class="section-title">Experience</h2>
          <div class="h-1 w-16 rounded-full" style={`background-color:${siteConfig.accentColor}`}></div>
        </header>

        <div class="space-y-4 lg:col-span-8">
          {siteConfig.experience.map((exp) => (
            <article class="card-panel">
              <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <h3 class="text-lg font-semibold text-[var(--text-strong)]">{exp.title}</h3>
                  <p class="text-sm" style={`color:${siteConfig.accentColor}`}>{exp.company}</p>
                </div>
                <p class="text-xs text-[var(--text-muted)] sm:text-sm">{exp.dateRange}</p>
              </div>
              <ul class="mt-3 space-y-2">
                {exp.bullets.map((bullet) => (
                  <li class="text-sm text-[var(--text-muted)]">• {bullet}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
