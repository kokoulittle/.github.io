---
import { siteConfig } from "../config";

const aboutParagraphs = Array.isArray(siteConfig.aboutMe)
  ? siteConfig.aboutMe
  : [siteConfig.aboutMe];
---

<section id="about" aria-labelledby="about-heading" class="section-shell">
  <div class="section-grid">
    <header class="space-y-3 lg:col-span-4">
      <p class="section-kicker">Profile</p>
      <h2 id="about-heading" class="section-title">About</h2>
      <div class="h-1 w-16 rounded-full" style={`background-color:${siteConfig.accentColor}`}></div>
    </header>

    <div class="space-y-5 lg:col-span-8">
      {aboutParagraphs.map((paragraph) => (
        <p class="text-sm leading-7 text-[var(--text-default)] sm:text-base">{paragraph}</p>
      ))}

      <ul class="flex flex-wrap gap-2 pt-2" aria-label="Skills">
        {siteConfig.skills.map((skill) => (
          <li class="rounded-full border border-[var(--border-soft)] bg-white px-3 py-1.5 text-xs text-[var(--text-muted)] sm:text-sm">
            {skill}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
