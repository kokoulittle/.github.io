---
import { siteConfig } from "../config";
---

<section id="hero" class="relative overflow-hidden border-b border-[var(--border-soft)] bg-white" style={`--accent-color:${siteConfig.accentColor}`}>
  <div class="section-shell">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8 space-y-5">
        <p class="section-kicker">Portfolio</p>
        <h1 class="text-3xl font-semibold tracking-tight text-[var(--text-strong)] sm:text-4xl md:text-5xl">
          {siteConfig.name}
        </h1>
        <p class="max-w-2xl text-base text-[var(--text-default)] sm:text-lg">
          {siteConfig.title}
        </p>
        <div class="flex flex-wrap gap-3 pt-2 text-sm">
          {siteConfig.social?.email && (
            <a href={`mailto:${siteConfig.social.email}`} class="focus-ring rounded-full px-4 py-2 font-medium text-white transition-opacity hover:opacity-90" style={`--tw-ring-color:${siteConfig.accentColor};background-color:${siteConfig.accentColor}`}>
              Email me
            </a>
          )}
          <a href="#projects" class="focus-ring rounded-full border border-[var(--border-soft)] px-4 py-2 text-[var(--text-strong)] transition-colors hover:bg-slate-50" style={`--tw-ring-color:${siteConfig.accentColor}`}>
            View projects
          </a>
        </div>
      </div>
      <aside class="lg:col-span-4 card-panel space-y-3">
        <p class="section-kicker">Core focus</p>
        <ul class="space-y-2 text-sm text-[var(--text-muted)]">
          <li>• Data science for finance and climate strategy</li>
          <li>• Practical machine learning and text analytics</li>
          <li>• Decision-ready dashboards and automation</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
