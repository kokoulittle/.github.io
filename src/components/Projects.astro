---
import { siteConfig } from "../config";
const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" aria-labelledby="projects-heading" class="section-shell">
      <div class="section-grid">
        <header class="space-y-3 lg:col-span-4">
          <p class="section-kicker">Work</p>
          <h2 id="projects-heading" class="section-title">Projects</h2>
          <div class="h-1 w-16 rounded-full" style={`background-color:${siteConfig.accentColor}`}></div>
        </header>

        <div class="space-y-4 lg:col-span-8">
          {siteConfig.projects.map((project) => {
            const Component = project.link ? "a" : "article";
            const linkProps = project.link
              ? {
                  href: project.link,
                  target: "_blank",
                  rel: "noopener noreferrer",
                }
              : {};

            return (
              <Component
                {...linkProps}
                class="card-panel block transition-colors hover:bg-slate-50"
              >
                <h3 class="text-lg font-semibold text-[var(--text-strong)]">{project.name}</h3>
                <p class="mt-2 text-sm text-[var(--text-muted)] sm:text-base">{project.description}</p>
                {project.skills && project.skills.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Project skills">
                    {project.skills.map((skill) => (
                      <li class="rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-700">{skill}</li>
                    ))}
                  </ul>
                )}
              </Component>
            );
          })}
        </div>
      </div>
    </section>
  )
}
